RewriteEngine On
RewriteRule ^employees/?$ employees/index.php [L,QSA]
RewriteRule ^employees/([0-9]+)/?$ employees/index.php?id=$1 [L,QSA]
RewriteRule ^employees/([0-9]+)/history/?$ employees/history.php?id=$1 [L,QSA]
RewriteRule ^employees/([0-9]+)/(promotion|transfer|regularize|resign|terminate)/?$ employees/lifecycle.php?id=$1&action=$2 [L,QSA]
RewriteRule ^(departments|positions|branches)/?$ catalog.php?type=$1 [L,QSA]
RewriteRule ^integration/employees/([0-9]+)/employment/?$ integration/employment.php?id=$1 [L,QSA]
RewriteRule ^integration/employees/([0-9]+)/status/?$ integration/status.php?id=$1 [L,QSA]
RewriteRule ^integration/employees/([0-9]+)/?$ integration/employee.php?id=$1 [L,QSA]
RewriteRule ^integration/(departments|positions|branches)/([0-9]+)/?$ integration/catalog.php?type=$1&id=$2 [L,QSA]
RewriteRule ^ai/employee-profile/?$ ai/employee-profile.php [L,QSA]
RewriteRule ^ai/employee-profile/([0-9]+)/?$ ai/employee-profile.php?id=$1 [L,QSA]
RewriteRule ^ai/employee-profile/([0-9]+)/regenerate/?$ ai/employee-profile.php?id=$1&action=regenerate [L,QSA]
RewriteRule ^ai/employee-profile/([0-9]+)/approve/?$ ai/employee-profile.php?id=$1&action=approve [L,QSA]
RewriteRule ^ai/employee-profile/([0-9]+)/reject/?$ ai/employee-profile.php?id=$1&action=reject [L,QSA]
RewriteRule ^ai/document-draft/?$ ai/document-draft.php [L,QSA]
RewriteRule ^ai/document-draft/([0-9]+)/?$ ai/document-draft.php?id=$1 [L,QSA]
RewriteRule ^ai/document-draft/([0-9]+)/regenerate/?$ ai/document-draft.php?id=$1&action=regenerate [L,QSA]
RewriteRule ^ai/document-draft/([0-9]+)/submit-review/?$ ai/document-draft.php?id=$1&action=submit-review [L,QSA]
RewriteRule ^ai/document-draft/([0-9]+)/approve/?$ ai/document-draft.php?id=$1&action=approve [L,QSA]
RewriteRule ^ai/document-draft/([0-9]+)/reject/?$ ai/document-draft.php?id=$1&action=reject [L,QSA]
RewriteRule ^ai/document-draft/([0-9]+)/finalize/?$ ai/document-draft.php?id=$1&action=finalize [L,QSA]